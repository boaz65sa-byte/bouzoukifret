# העתק ל-.env והזן את הערכים (.env ב-.gitignore — לא נכנס ל-git)

# מפתח LALAL.ai — חובה להפרדת מיתרים/בוזוקי. נרשמים ב-lalal.ai
LALAL_LICENSE_KEY=

# הפורט שעליו השרת מאזין
PORT=3456

# מאיזה origin מותר לפנות (האפליקציה). * = הכל (רק לפיתוח מקומי)
# בפרודקשן: כתובת האפליקציה, למשל https://your-app.example.com
ALLOW_ORIGIN=*

# נתיב ל-yt-dlp אם לא ב-PATH (אופציונלי)
# YTDLP_PATH=yt-dlp
